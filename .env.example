# Copia este archivo como .env y completa tus datos de MongoDB Atlas
# Usuario de Atlas: jsantosa5_db_user
#
# Cómo obtener la URI:
# 1. En MongoDB Atlas → Database → Connect → Drivers
# 2. Copia la cadena <URI_MONGODB_ELIMINADA>
# 3. Reemplaza <password> por la contraseña real del usuario
# 4. (Opcional) cambia "farmacia" por el nombre de tu base de datos

PORT=3000
MONGODB_URI=<URI_MONGODB_ELIMINADA>
